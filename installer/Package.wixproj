<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>Sembazuru</OutputName>
    <OutputType>Package</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 64-bit package so binaries land under Program Files (not the x86 view),
         which the GUI self-elevation image-integrity assumption requires. -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <!--
    File-source and version inputs. Defaults assume a release build at the repo
    root (target/release + hooks/build/Release); CI overrides them on the command
    line, e.g.:
      dotnet build installer/Package.wixproj -c Release -p:Platform=x64 \
        -p:SbzVersion=0.0.3 -p:SbzRustTarget=... -p:SbzHooks=...
    These flow to the .wxs as $(var.RustTarget) / $(var.Hooks) / $(var.Integration)
    / $(var.ProductVersion).
  -->
  <PropertyGroup>
    <SbzRustTarget Condition="'$(SbzRustTarget)' == ''">$(MSBuildProjectDirectory)\..\target\release</SbzRustTarget>
    <SbzStoreCtl Condition="'$(SbzStoreCtl)' == ''">$(SbzRustTarget)\sembazuru-storectl.exe</SbzStoreCtl>
    <SbzRollbackFixture Condition="'$(SbzRollbackFixture)' == ''">0</SbzRollbackFixture>
    <SbzHooks Condition="'$(SbzHooks)' == ''">$(MSBuildProjectDirectory)\..\hooks\build\Release</SbzHooks>
    <SbzIntegration Condition="'$(SbzIntegration)' == ''">$(MSBuildProjectDirectory)\..\docs\integrations\msbuild</SbzIntegration>
    <SbzVersion Condition="'$(SbzVersion)' == ''">0.0.3</SbzVersion>
    <DefineConstants>ProductVersion=$(SbzVersion);RustTarget=$(SbzRustTarget);StoreCtl=$(SbzStoreCtl);RollbackFixture=$(SbzRollbackFixture);Hooks=$(SbzHooks);Integration=$(SbzIntegration)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile only the MSI package source; Bundle.wixproj owns bundle.wxs. -->
    <Compile Remove="**/*.wxs" />
    <Compile Include="sembazuru.wxs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Firewall extension for the LAN listen-port exceptions (M9.5b). -->
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(SbzRollbackFixture)' == '1'">
    <!-- Build-time-only rollback fault injection; never linked into production MSI. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
